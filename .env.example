# Copy to .env and adjust. Every setting can also be set as an environment variable.

# "ollama" (default) or "fake" (deterministic stand-in, no Ollama needed - used by tests)
DOCQA_LLM_BACKEND=ollama

# Native Windows Ollama listens here by default
DOCQA_OLLAMA_HOST=http://localhost:11434
DOCQA_CHAT_MODEL=llama3.2:3b
DOCQA_EMBED_MODEL=nomic-embed-text
DOCQA_TEMPERATURE=0.0
DOCQA_REQUEST_TIMEOUT=120

# Retrieval
DOCQA_CHUNK_SIZE=800
DOCQA_CHUNK_OVERLAP=120
DOCQA_TOP_K=4
# Chunks below this cosine similarity are ignored; if none remain the agent declines to answer
DOCQA_MIN_SCORE=0.55

# Memory: number of previous messages shown to the LLM
DOCQA_HISTORY_MESSAGES=6

# Where the index, memory DB, traces and eval reports are stored
# DOCQA_DATA_DIR=./data
